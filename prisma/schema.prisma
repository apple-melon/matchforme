generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String?
  createdAt     DateTime       @default(now())
  tournaments   Tournament[]
  participants  Participant[]
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Tournament {
  id                  String         @id @default(cuid())
  code                String         @unique
  adminSecret         String
  title               String         @default("")
  format              String         @default("TOURNAMENT")
  bracketJson         String?
  matchResultsJson    String?
  collectedFieldsJson String         @default("[]")
  splitClassCount     Int            @default(3)
  seedBy              String         @default("random")
  ownerId             String?
  owner               User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // 대회 시작 시각 — 이후에만 경기 결과 입력 가능
  startedAt           DateTime?
  // 대회 종료 시각 — 이후 경기 결과 수정 불가
  endedAt             DateTime?
  createdAt           DateTime       @default(now())
  participants        Participant[]

  @@index([ownerId])
}

model Participant {
  id            String     @id @default(cuid())
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  affiliation   String
  weightKg      Float?
  heightCm      Float?
  age           Int?
  createdAt     DateTime   @default(now())

  @@index([tournamentId])
  @@index([userId])
}
