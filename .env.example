# Neon 대시보드 → 프로젝트 → Connection details 에서 복사
# "psql" 또는 "Connection string" 형태 (postgresql://...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# 세션 JWT 서명용 (16자 이상). 비워 두면 DATABASE_URL 기반으로 자동 파생됩니다.
# 프로덕션에서 별도 키를 쓰려면 설정하는 것을 권장합니다.
# SESSION_SECRET="랜덤-긴-문자열-16자리-이상"
